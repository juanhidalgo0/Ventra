# Variables para correr GO! Portal en un servidor propio (no en la PC del cliente).
# El Dockerfile ya fija DATABASE_URL, PORT y DISABLE_TUNNEL — normalmente solo hace falta
# definir los secretos JWT reales al levantar el contenedor.

JWT_SECRET="reemplazar-por-un-secreto-largo-y-random"
JWT_REFRESH_SECRET="reemplazar-por-otro-secreto-largo-y-random"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Firebase (sync con GoDelivery) — pegar el JSON completo de la service account en una sola línea
FIREBASE_CREDENTIALS_JSON=""
GODELIVERY_COMERCIO_ID=""
