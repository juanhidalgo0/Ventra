# Copiar como .env (está en .gitignore: el repo es público, la clave NUNCA va en git).
# Lo usa scripts/ventri-fabrica.py para pedir la voz de Ventri a ElevenLabs.

# ElevenLabs → Profile/Settings → API Keys
ELEVENLABS_API_KEY=

# El ID de Valeria (Voice Library → los tres puntitos de la voz → "Copy voice ID")
VENTRI_VOICE_ID=

# Opcional. Sin esto busca solo el modelo "v4" de la cuenta.
# VENTRI_ELEVEN_MODEL=
# Opcional. Biblia: stability 15 %.
# VENTRI_STABILITY=0.15
