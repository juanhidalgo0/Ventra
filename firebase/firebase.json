{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "ventra",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "web",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "rewrites": [
        {
          "source": "/admin",
          "destination": "/admin.html"
        },
        {
          "source": "/panel",
          "destination": "/panel.html"
        },
        {
          "source": "/peluquerias",
          "destination": "/peluquerias.html"
        }
      ],
      "redirects": [
        {
          "source": "/peluquerias.html",
          "destination": "/peluquerias",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "/ventra-cuenta.js",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
        },
        {
          "source": "/@(sitemap.xml|robots.txt)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
        }
      ]
    },
    {
      "target": "tienda",
      "public": "tienda",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "function": { "functionId": "storePage", "region": "us-central1" }
        }
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8095
    },
    "auth": {
      "port": 9095
    },
    "ui": {
      "enabled": false
    }
  }
}