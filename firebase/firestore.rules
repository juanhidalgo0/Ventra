rules_version = '2';

// Reglas de Firestore del proyecto de Ventra (ventra-9cba5).
// Todo lo que no está permitido explícitamente acá queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Aviso de versión nueva del POS ──────────────────────────────
    // Lectura pública; solo escribe la función publishDesktopVersion (admin).
    match /ventra_desktop/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Cuentas / suscripciones (landing + cuenta.html) ─────────────
    // Cada usuario lee solo su cuenta; solo las funciones escriben.
    match /ventra_accounts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Cupo de recordatorios automáticos por WhatsApp (reminder-quota.js): el dueño ve cuánto le
    // queda; lo cuentan y acreditan solo las funciones. Los pagos de paquetes, ni eso.
    match /ventra_wa_quota/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /ventra_wa_packs/{paymentId} {
      allow read, write: if false;
    }

    // ── Tiendas online ──────────────────────────────────────────────
    // ownerUid = sesión (anónima) del POS dueño de la tienda.
    // claimed  = la tienda ya tiene dueño y es visible públicamente.
    // Avisos al celular: cada cuenta registra sus celulares y elige qué avisos recibir
    // Estado de un cobro del Point (lo escribe la nube): la caja de la cuenta lo escucha en vivo
    match /ventra_mp_orders/{orderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /ventra_push/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /tokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Registro de direcciones de las tiendas (tienda.ventra.store/<dirección> → tienda).
    // Lo escribe solo la función ventraStoreSlug: así nadie puede quedarse con la dirección
    // de otro comercio.
    match /ventra_store_slugs/{slug} {
      allow get: if true;
      allow list, write: if false;
    }

    match /ventra_stores/{storeId} {
      function isOwner() {
        return signedIn() && resource.data.get('ownerUid', null) == request.auth.uid;
      }
      function keepsOwnerAs(uid) {
        return request.resource.data.ownerUid == uid && request.resource.data.claimed == true;
      }

      // Por ID: se puede leer (hace falta conocer el ID). Listados: solo tiendas
      // reclamadas, así las migradas sin dueño no quedan expuestas a que las reclame otro.
      allow get: if true;
      allow list: if resource.data.claimed == true;

      // createdAt lo pone el servidor y no cambia: decide quién conserva una dirección
      // (ver functions/store-slugs.js), así que nadie puede antedatar su tienda.
      allow create: if signedIn() && keepsOwnerAs(request.auth.uid)
        && request.resource.data.createdAt == request.time;
      // La tienda migrada sin dueño la reclama la primera sesión que la edita;
      // después solo su dueño puede tocarla.
      allow update: if signedIn() && keepsOwnerAs(request.auth.uid)
        && (isOwner() || resource.data.get('ownerUid', null) == null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isOwner();

      function storeOwner() {
        return signedIn()
          && get(/databases/$(database)/documents/ventra_stores/$(storeId)).data.get('ownerUid', null) == request.auth.uid;
      }

      // Celulares del dueño que reciben avisos de pedidos nuevos
      match /pushTokens/{tokenId} {
        allow read, write: if storeOwner();
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if storeOwner();
      }

      // El mismo catálogo agrupado en pocos documentos: la tienda lo lee de una vez
      match /catalog/{partId} {
        allow read: if true;
        allow write: if storeOwner();
      }

      // Agenda de turnos: los turnos (con datos del cliente) solo los ve el dueño.
      // El público reserva por la función agendaBook, que evita turnos superpuestos.
      match /bookings/{bookingId} {
        allow read, write: if storeOwner();
      }
      // Clientes de la agenda (resumen por cliente y nota del dueño): solo el dueño.
      match /agenda_clients/{clientId} {
        allow read, write: if storeOwner();
      }
      // Consultorio de nutrición: datos de salud, solo el dueño. La historia clínica se guarda
      // (ley 26.529): el paciente no se borra, se archiva.
      match /nutri_patients/{patientId} {
        allow read, create, update: if storeOwner();
        allow delete: if false;

        // Una consulta se corrige o se borra solo en las primeras 24 h. Después queda fija y
        // solo se le agregan notas al final (addenda), sin tocar las anteriores.
        match /consultas/{consultaId} {
          function fresh() {
            return request.time < resource.data.createdAt + duration.value(24, 'h');
          }
          function onlyAddsNote() {
            let before = resource.data.get('addenda', []);
            let after = request.resource.data.addenda;
            return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addenda'])
              && after is list && after.size() == before.size() + 1 && after.size() <= 50
              && after[0:before.size()] == before;
          }
          allow read: if storeOwner();
          allow create: if storeOwner() && request.resource.data.createdAt == request.time;
          allow update: if storeOwner() && request.resource.data.createdAt == resource.data.createdAt
            && (fresh() || onlyAddsNote());
          allow delete: if storeOwner() && fresh();
        }
      }

      // Horarios ocupados por día (sin datos personales), para mostrar los libres.
      // Los mantiene la función ventraBookingWritten.
      match /agenda_busy/{dateKey} {
        allow read: if true;
        allow write: if false;
      }

      // Cupones: solo el dueño (los códigos no son públicos). La tienda los valida con la
      // función storeCouponCheck y los usos los cuenta la nube al llegar el pedido.
      match /coupons/{code} {
        allow read, write: if storeOwner();
        match /redemptions/{phone} {
          allow read: if storeOwner();
          allow write: if false;
        }
      }

      // Clientes de una distribuidora con link personal: el id es un código secreto que Ventra le
      // manda a cada comercio. Quien lo tiene lee sus datos (nombre, dirección, último pedido);
      // listarlos o escribirlos, solo el dueño.
      match /clients/{token} {
        allow get: if true;
        allow list, write: if storeOwner();
      }
      // Venta a comercios: unidades libres de cada producto (stock menos lo comprometido en pedidos),
      // para que la tienda no deje pedir de más. Lo escribe solo el dueño (refreshWholesaleStock).
      match /stock/{docId} {
        allow get: if true;
        allow list, write: if storeOwner();
      }

      match /orders/{orderId} {
        // Cualquier cliente puede hacer un pedido, con formato válido.
        allow create: if validNewOrder();
        // Solo el dueño los ve y los marca como sincronizados.
        allow read, update, delete: if storeOwner();

        function validNewOrder() {
          let o = request.resource.data;
          return o.keys().hasOnly(['items', 'total', 'customerName', 'customerPhone', 'customerNote', 'status', 'syncedLocal', 'createdAt',
                                   'orderCode', 'delivery', 'address', 'paymentMethod', 'deliveryCost', 'discount', 'coupon', 'clientToken'])
            // Link personal del cliente de una distribuidora (ver clients/ arriba)
            && (!('clientToken' in o) || (o.clientToken is string && o.clientToken.size() >= 16 && o.clientToken.size() <= 64))
            && (!('discount' in o) || (o.discount is number && o.discount >= 0))
            // El cupón lo valida la nube al crearse el pedido (coupon.valid o couponProblem)
            && (!('coupon' in o) || (o.coupon is map && o.coupon.keys().hasOnly(['code', 'discount', 'type'])
                && o.coupon.code is string && o.coupon.code.size() <= 24
                && o.coupon.discount is number && o.coupon.discount >= 0))
            && (!('orderCode' in o) || (o.orderCode is string && o.orderCode.size() <= 12))
            && (!('delivery' in o) || o.delivery in ['PICKUP', 'DELIVERY', 'GODELIVERY', 'TABLE', 'REPARTO'])
            && (!('address' in o) || (o.address is string && o.address.size() <= 300))
            && (!('paymentMethod' in o) || (o.paymentMethod is string && o.paymentMethod.size() <= 60))
            && (!('deliveryCost' in o) || (o.deliveryCost is number && o.deliveryCost >= 0))
            && o.items is list && o.items.size() > 0 && o.items.size() <= 200
            && o.total is number && o.total >= 0
            && o.customerName is string && o.customerName.size() > 0 && o.customerName.size() <= 120
            && o.customerPhone is string && o.customerPhone.size() <= 40
            && (!('customerNote' in o) || (o.customerNote is string && o.customerNote.size() <= 1000))
            && o.status == 'PENDING'
            && o.syncedLocal == false
            && o.createdAt == request.time;
        }
      }
    }
  }
}
