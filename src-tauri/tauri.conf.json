{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ventra",
  "version": "1.0.37",
  "identifier": "com.godelivery.pos",
  "build": {
    "frontendDist": "../apps/frontend/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "node -e \"require(require('fs').existsSync('cleanup-backend.js')?'./cleanup-backend.js':'../cleanup-backend.js')\"",
    "beforeBuildCommand": "node -e \"require(require('fs').existsSync('cleanup-backend.js')?'./cleanup-backend.js':'../cleanup-backend.js')\""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ventra",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "devtools": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 320,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/juanhidalgo0/Ventra/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNjFFMTJCMkNCMTQ4NjUKUldSbFNMRXNLK0ZoVURGNXZETkJaZmllTFl5alBmL1BwYVYrdjY4c3c5RDl6ZzI4S01OUHdFbW8K",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../apps/backend/dist/ncc",
      "../apps/backend/bin/*",
      "../apps/frontend/dist",
      "../.env"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer-header.bmp",
        "sidebarImage": "installer-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish"]
      }
    }
  }
}
