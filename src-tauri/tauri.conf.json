{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GO! Portal",
  "version": "1.0.0",
  "identifier": "com.godelivery.pos",
  "build": {
    "frontendDist": "../apps/frontend/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "GO! Portal",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": true,
        "devtools": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../apps/backend/dist/ncc",
      "../apps/backend/prisma/dev.db",
      "../apps/backend/bin/*"
    ]
  }
}
