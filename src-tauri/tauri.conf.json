{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GO! Portal",
  "version": "1.0.1",
  "identifier": "com.godelivery.pos",
  "build": {
    "frontendDist": "../apps/frontend/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "node -e \"require(require('fs').existsSync('cleanup-backend.js')?'./cleanup-backend.js':'../cleanup-backend.js')\"",
    "beforeBuildCommand": "node -e \"require(require('fs').existsSync('cleanup-backend.js')?'./cleanup-backend.js':'../cleanup-backend.js')\""
  },
  "app": {
    "windows": [
      {
        "title": "GO! Portal",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": true,
        "devtools": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/juanhidalgo0/GoPortal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3ODRCRTY2M0I1RkFFNTcKUldSWHJsODdacjZFRjk0MUlYM2ZvTFRZOTh3eWt2TU9QSDBvM29FZXJuVVZ0LzdtTWR2Q3VxR2wK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../apps/backend/dist/ncc",
      "../apps/backend/prisma/dev.db",
      "../apps/backend/bin/*",
      "../apps/frontend/dist"
    ]
  }
}
